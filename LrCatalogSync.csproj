<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
	    <OutputType>WinExe</OutputType>
	    <TargetFramework>net10.0-windows</TargetFramework>
      <NeutralLanguage>en</NeutralLanguage>
      <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
	    <Nullable>enable</Nullable>
	    <UseWindowsForms>true</UseWindowsForms>
	    <ImplicitUsings>enable</ImplicitUsings>
	    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
	    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
	    <SignManifests>false</SignManifests>
		  <NoWarn>$(NoWarn);CA1416</NoWarn> <!--Ignorieren weil Windows only-->	
      	
      <!-- Application Icon -->
      <ApplicationIcon>src\Resources\Icons\app_icon.ico</ApplicationIcon>
      
      <!-- Self-Contained Deployment - .NET in die EXE integriert -->
      <PublishSingleFile>true</PublishSingleFile>
      <SelfContained>true</SelfContained>
      <PublishFolder>bin\Publish</PublishFolder>

	    <!-- Assembly-Metadaten  -->
	    <AssemblyTitle>LrCatalogSync</AssemblyTitle>
	    <Description>Synchronisiert ein Katalog von Adobe Lightroom Classic.</Description>
	    <Company>Fototour-und-Technik.de</Company>
	    <Product>LrCatalogSync</Product>
	    <Copyright>© 2026 Fototour-und-Technik.de</Copyright>
	    <AssemblyVersion>1.0.0</AssemblyVersion>
	    <FileVersion>1.0.0</FileVersion>
	    <Version>1.0.0</Version>
    </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.9" />
    <PackageReference Include="SMBLibrary" Version="1.5.7" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="src\UI\SettingsForm.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
  <Compile Update="src\UI\UsbExportForm.cs">
    <SubType>Form</SubType>
  </Compile>
</ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="src\Resources\Icons\*.ico">
      <LogicalName>LrCatalogSync.Resources.Icons.%(Filename).ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="src\Resources\Strings\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
      <LogicalName>LrCatalogSync.Resources.Strings.Strings.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="src\Resources\Strings\Strings.de.resx">
      <LogicalName>LrCatalogSync.Resources.Strings.Strings.de.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="**\*.config;**\*.log;">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

</Project>